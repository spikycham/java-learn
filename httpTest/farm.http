### Create a farm.
POST /api/farm HTTP/2.0
Host: 127.0.0.1:8080
Content-Type: application/json
Accept: application/json

{
    "user_id": "00000001",
    "name": "Farm Test B",
    "location": "New York City Center",
    "color_string": "#918fff"
}

### Get farm list.
GET /api/farm/list/00000001 HTTP/2.0
Host: 127.0.0.1:8080
Accept: application/json

### Update farm properties.
PATCH /api/farm HTTP/2.0
Host: 127.0.0.1:8080
Content-Type: application/json
Accept: application/json

{
    "farm_id": "afc39ed6",
    "name": "Upated Farm A",
    "location": "Updated New York City",
    "color_string": "#000fff"
}

### Delete a farm.
DELETE /api/farm/1e2fd1d6 HTTP/2.0
Host: 127.0.0.1:8080
